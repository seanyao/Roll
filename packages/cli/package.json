{
  "name": "@roll/cli",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm run test:parallel && pnpm run test:stateful",
    "test:parallel": "vitest run --passWithNoTests --exclude test/multi-repo-capture-facts.test.ts --exclude test/runner-repository-context.test.ts",
    "test:stateful": "vitest run test/multi-repo-capture-facts.test.ts test/runner-repository-context.test.ts --maxWorkers=1 --no-file-parallelism",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@roll/core": "workspace:*",
    "@roll/infra": "workspace:*",
    "@roll/spec": "workspace:*"
  }
}
